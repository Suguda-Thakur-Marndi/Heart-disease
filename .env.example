# HeartGuard Environment Variables

# Frontend
# In local development, NEXT_PUBLIC_API_URL can be set if running standalone front/back:
NEXT_PUBLIC_API_URL=http://localhost:8000
# On Vercel, BACKEND_URL is automatically injected into the frontend service via service bindings.
# Do not set BACKEND_URL manually in Vercel project settings.

# Backend
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
